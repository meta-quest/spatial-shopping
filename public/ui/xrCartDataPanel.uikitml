              <span class="remove-text">Remove</span>
            </div>
          </div>
        </div>
      </div>
      <div class="cart-item-price">
        <span class="price-value" id="price-value-9">$79.99</span>
      </div>
    </div>
  </div>

  <div class="empty-cart-state" id="empty-cart-state">
    <img src="imgs/store-cart.png" class="empty-cart-icon" />
    <span class="empty-cart-title">Your cart is empty!</span>
    <span class="empty-cart-message">Looks like you haven't added anything to your cart yet</span>
  </div>

  <div class="total-section" id="total-section">
    <span class="total-label" id="total-label">Total price</span>
    <span class="total-price" id="total-price">$169.98</span>
  </div>

  <div class="buttons-section">
    <div class="cart-button back-button" id="back-button">
      <div class="back-button-inner">
        <span class="back-button-text">Back</span>
      </div>
    </div>
    <div class="cart-button checkout-button" id="checkout-button">
      <div class="checkout-button-inner">
        <span class="checkout-button-text">Continue to checkout</span>
        <img src="imgs/arrow-right.png" class="arrow-icon" />
      </div>
    </div>
  </div>
</div>
