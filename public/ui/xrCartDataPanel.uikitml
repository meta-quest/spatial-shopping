<style>
  .cart-data-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 63.6;
    height: 79.4;
    background-color: #ffffff;
    border-radius: 2.4;
    padding: 3.2;
    padding-bottom: 1.8;
    gap: 0;
  }

  .cart-header {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 1.2;
    gap: 0.4;
  }

  .cart-header-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
  }

  .cart-header-title {
    font-size: 2;
    font-weight: bold;
    line-height: 2.4;
    letter-spacing: -0.05;
    color: #272727;
    flex-grow: 1;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.2;
    overflow: scroll;
    scrollbar-width: 0;
    height: 48;
    padding: 0;
    padding-bottom: 1.6;
  }

  .cart-item-card {
    display: none;
    flex-direction: row;
    align-items: center;
    padding: 1.2;
    padding-left: 1.2;
    padding-right: 2.4;
    gap: 1.2;
    width: 57.2;
    height: 13.6;
    background-color: rgba(39, 39, 39, 0.05);
    align-self: stretch;
    flex-grow: 0;
  }

  .cart-item-image-container {
    width: 11.2;
    height: 11.2;
    min-width: 11.2;
    min-height: 11.2;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f2f2f2;
    border-radius: 0.4;
    flex-grow: 0;
  }

  .cart-item-image {
    width: 11.2;
    height: 11.2;
    max-width: 11.2;
    max-height: 11.2;
  }

  .cart-item-middle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0;
    gap: 1.2;
    width: 24;
    height: 11.2;
    flex-grow: 0;
  }

  .cart-item-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 0;
    padding-top: 1.2;
    gap: 0.4;
    width: 24;
    height: 5.2;
    flex-grow: 0;
  }

  .cart-item-name {
    font-size: 1.4;
    line-height: 2;
    font-weight: bold;
    color: #272727;
    text-align: left;
    width: 100%;
  }

  .cart-item-subtitle {
    font-size: 1.2;
    line-height: 1.6;
    font-weight: medium;
    color: #5e6964;
    text-align: left;
    width: 100%;
  }

  .cart-item-controls {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding: 0;
    gap: 0.4;
    height: 4.8;
    flex-grow: 0;
  }

  .quantity-control {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0;
    width: 12.8;
    height: 4.8;
    background-color: #ffffff;
    border-radius: 2.4;
    flex-grow: 0;
  }

  .quantity-button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 4.8;
    height: 4.8;
    cursor: pointer;
  }

  .quantity-button-inner {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 3.2;
    height: 3.2;
    background-color: rgba(39, 39, 39, 0.05);
    border-radius: 100;
    padding: 0.8;
  }

  .quantity-icon {
    width: 1.6;
    height: 1.6;
  }

  .quantity-value {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 3.2;
    height: 4.8;
    font-size: 1.4;
    line-height: 2;
    font-weight: medium;
    color: #000000;
    text-align: center;
  }

  .remove-button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 10.8;
    height: 4.8;
    cursor: pointer;
  }

  .remove-button-inner {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.8;
    padding-left: 1.6;
    padding-right: 1.6;
    gap: 0.8;
    height: 3.2;
    border-radius: 100;
  }

  .remove-icon {
    width: 1.6;
    height: 1.6;
  }

  .remove-text {
    font-size: 1.2;
    line-height: 1.6;
    font-weight: medium;
    color: #272727;
  }

  .cart-item-price {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding: 0;
    width: 16;
    height: 11.2;
    flex-grow: 0;
  }

  .price-value {
    font-size: 2;
    line-height: 2.4;
    font-weight: medium;
    letter-spacing: -0.05;
    color: #000000;
    white-space: normal;
    text-align: right;
    width: 100%;
  }

  .total-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding: 2.4;
    gap: 0.9;
    height: 10.9;
  }

  .total-label {
    font-size: 1.2;
    line-height: 1.6;
    font-weight: medium;
    color: #5e6964;
    text-align: right;
  }

  .total-price {
    font-size: 3.2;
    line-height: 3.6;
    font-weight: bold;
    letter-spacing: -0.1;
    color: #000000;
    text-align: right;
  }

  .buttons-section {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0;
    gap: 1.2;
    width: 100%;
  }

  .cart-button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 4.8;
    cursor: pointer;
  }

  .back-button {
    width: 100%;
  }

  .checkout-button {
    width: 100%;
    display: none;
  }

  .back-button-inner {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.8;
    padding-left: 1.6;
    padding-right: 1.6;
    gap: 0.8;
    min-width: 8;
    height: 4.4;
    border-radius: 100;
    flex-grow: 1;
    background-color: rgba(39, 39, 39, 0.05);
  }

  .checkout-button-inner {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.8;
    padding-left: 1.6;
    padding-right: 1.6;
    gap: 0.8;
    min-width: 8;
    height: 4.4;
    border-radius: 100;
    flex-grow: 1;
    background-color: #000000;
  }

  .back-button-text {
    font-size: 1.4;
    line-height: 2;
    font-weight: medium;
    padding: 0.2;
    padding-left: 0;
    padding-right: 0;
    text-align: center;
    width: 100%;
    color: #272727;
  }

  .checkout-button-text {
    font-size: 1.4;
    line-height: 2;
    font-weight: medium;
    padding: 0.2;
    padding-left: 0;
    padding-right: 0;
    text-align: center;
    width: 100%;
    color: #ffffff;
  }

  .arrow-icon {
    width: 2.4;
    height: 2.4;
  }

  .empty-cart-state {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    flex-grow: 1;
    gap: 2.4;
    min-height: 58.9;
  }

  .empty-cart-icon {
    width: 12.8;
    height: 12.8;
  }

  .empty-cart-title {
    font-size: 3.6;
    line-height: 3.6;
    font-weight: bold;
    color: #000000;
    text-align: center;
  }

  .empty-cart-message {
    font-size: 1.6;
    line-height: 2;
    font-weight: normal;
    color: #8e8e8e;
    text-align: center;
    width: 24;
    height: 4;
  }
</style>

