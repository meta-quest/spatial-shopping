<style>
  .variant-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: transparent;
  }

  .variants-grid {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: 1.1;
  }

  .pagination-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .variants-row {
    display: flex;
    flex-direction: row;
    width: 90%;
    gap: 1.1;
    justify-content: space-between;
  }

  .variant-card {
    display: flex;
    flex-direction: column;
    width: 16;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 1.6;
    border-width: 0.1;
    border-color: #e0e0e0;
    padding: 1;
    cursor: pointer;
  }

  .variant-card--selected {
    border-color: #272727;
    border-width: 0.2;
  }

  .variant-card--loading {
    opacity: 0.4;
  }

  .variant-image-container {
    width: 100%;
    height: 13.8;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f5f5f5;
    border-radius: 1;
    margin-bottom: 2;
  }

  .variant-image {
    width: 100%;
    height: 100%;
  }

  .variant-info {
    display: flex;
    flex-direction: column;
    height: 6;
    justify-content: center;
  }

  .variant-name {
    font-size: 1.6;
    line-height: 2.2;
    font-weight: medium;
    color: #272727;
    text-align: left;
  }

  .variant-price {
    font-size: 1.4;
    line-height: 1.8;
    font-weight: medium;
    color: #272727;
    text-align: left;
    margin-bottom: 1;
  }

  .pagination-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 8;
    height: 6;
    border-radius: 100;
    background-color: rgba(255, 255, 255, 0.8);
    border-color: #272727;
    cursor: pointer;
  }

  .pagination-button--disabled {
    visibility: hidden;
    pointer-events: none;
  }

  .pagination-button-icon {
    width: 50%;
    height: 50%;
  }

</style>

<div class="variant-panel" id="variant-panel">
  <div class="pagination-container">
    <div class="pagination-button" id="prev-page-button">
      <img src="imgs/back-button.png" class="pagination-button-icon" id="prev-page-icon" />
    </div>
    <div class="variants-grid">
      <!-- First row -->
      <div class="variants-row" id="variants-row-0"
        style="align-items: center; justify-content: space-evenly">
        <!-- Variant 1 -->
        <div class="variant-card" id="variant-card-0">
          <div class="variant-image-container">
            <img src="imgs/cube-3d-icon.png" class="variant-image" id="variant-image-0" />
          </div>
          <div class="variant-info">
            <span class="variant-name" id="variant-name-0">Back</span>
            <span class="variant-price" id="variant-price-0">$79.99</span>
          </div>
        </div>

        <!-- Variant 2 -->
        <div class="variant-card" id="variant-card-1">
          <div class="variant-image-container">
            <img src="imgs/cube-3d-icon.png" class="variant-image" id="variant-image-1" />
          </div>
          <div class="variant-info">
            <span class="variant-name" id="variant-name-1">Dark</span>
            <span class="variant-price" id="variant-price-1">$79.99</span>
          </div>
        </div>
      </div>

      <!-- Second row -->
      <div class="variants-row" id="variants-row-1">
        <!-- Variant 3 -->
        <div class="variant-card" id="variant-card-2">
          <div class="variant-image-container">
            <img src="imgs/cube-3d-icon.png" class="variant-image" id="variant-image-2" />
          </div>
          <div class="variant-info">
            <span class="variant-name" id="variant-name-2">Light</span>
            <span class="variant-price" id="variant-price-2">$79.99</span>
          </div>
        </div>

        <!-- Variant 4 -->
        <div class="variant-card" id="variant-card-3">
          <div class="variant-image-container">
            <img src="imgs/cube-3d-icon.png" class="variant-image" id="variant-image-3" />
          </div>
          <div class="variant-info">
            <span class="variant-name" id="variant-name-3">White</span>
            <span class="variant-price" id="variant-price-3">$79.99</span>
          </div>
        </div>
      </div>


    </div>
    <div class="pagination-button" id="next-page-button">
      <img src="imgs/forward-button.png" class="pagination-button-icon" id="next-page-icon" />
    </div>
  </div>
</div>
