<style>
  .panel-container {
    align-items: flex-start;
    width: 30;
    display: flex;
    flex-direction: column;
    gap: 2;
    background-color: transparent;
    border-radius: 0;
    pointer-events: none;
  }

  .product-info-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: rgba(252, 252, 252, 0.94);
    border-color: rgba(39, 39, 39, 0.08);
    border-width: 0.1;
    border-radius: 2.8;
    padding-top: 2.2;
    padding-right: 2.2;
    padding-bottom: 1.8;
    padding-left: 2.2;
    pointer-events: auto;
  }

  .product-title {
    font-size: 1.6;
    font-weight: bold;
    color: #202327;
    text-align: left;
    padding-left: 0.8;
    padding-right: 0.8;
    line-height: 1.25;
    margin-bottom: 0.6;
  }


  .rating-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 0.8;
    padding-right: 0.8;
    margin-bottom: 1.4;
    gap: 0.5;
  }

  .rating-value {
    font-size: 1.2;
    color: #202327;
    font-weight: medium;
    line-height: 1.3;
    margin-right: 0.5;
    max-width: 2.6;
  }

  .rating-stars-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.2;
    padding-bottom: 0.2;
  }

  .star-icon {
    width: 1.4;
    height: 1.4;
  }

  .rating-count {
    font-size: 1.2;
    color: #667078;
    line-height: 1.3;
    font-weight: medium;
  }

  .product-image-container {
    cursor: pointer;
    display: flex;
    width: 100%;
    height: 20.5;
    justify-content: center;
    align-items: center;
    background-color: #f1f3f5;
    border-radius: 1.4;
    margin-bottom: 1.4;
    overflow: hidden;
  }

  #product-image {
    height: 100%;
    width: auto;
    cursor: pointer;
  }

  .price-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.8;
    width: 100%;
    padding-left: 0.8;
    padding-right: 0.8;
  }

  .price {
    font-size: 2;
    font-weight: bold;
    color: #202327;
  }

  .dimensions-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-left: 0.8;
    padding-right: 0.8;
    gap: 0.4;
  }

  .section-title {
    font-size: 1.4;
    font-weight: bold;
    color: #202327;
    text-align: left;
  }

  .dimensions-text {
    font-size: 1.2;
    color: #667078;
    text-align: left;
  }


  .loading-product {
    width: 100%;
    height: 100%;
    margin-left: -100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 1.4;
    display: flex;
    opacity: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .loading-video {
    width: 8;
    height: 8;
  }

  .bottom-control-panel {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: rgba(252, 252, 252, 0.94);
    border-color: rgba(39, 39, 39, 0.08);
    border-width: 0.1;
    gap: 0.4;
    border-radius: 3;
    padding-top: 0.8;
    padding-right: 0.8;
    padding-bottom: 0.8;
    padding-left: 0.8;
    pointer-events: auto;
  }

  .control-button {
    width: 4.4;
    height: 4.4;
    background-color: transparent;
    border-radius: 2.2;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    border-width: 0;
  }

  .control-button:hover {
    background-color: rgba(39, 39, 39, 0.1);
  }

  .control-button:active {
    background-color: rgba(39, 39, 39, 0.15);
  }

  .control-button--active {
    background-color: rgba(39, 39, 39, 0.9);
  }

  .control-button--active:hover {
    background-color: rgba(39, 39, 39, 1);
  }

  .control-button--disabled {
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.3;
  }

  .control-button--disabled:hover {
    background-color: transparent;
  }

  .control-divider {
    width: 0.1;
    height: 2.4;
    margin-left: 0.6;
    margin-right: 0.6;
    background-color: rgba(39, 39, 39, 0.1);
  }

  .control-icon {
    width: 2.4;
    height: 2.4;
  }
</style>
<div class="panel-container">
  <!-- Product Info Card -->
  <div class="product-info-card">
    <span class="product-title" id="product-title">Home Accent Plant Mid-Century Modern Decor with Natural Style Sansevieria Plant for Living Room, Bedroom, Balcony, Office</span>

    <div class="rating-section">
      <span class="rating-value" id="rating-value">4.4</span>

      <div class="rating-stars-container" id="rating-stars">
        <img src="imgs/star-full.png" class="star-icon" id="star-1" />
        <img src="imgs/star-full.png" class="star-icon" id="star-2" />
        <img src="imgs/star-full.png" class="star-icon" id="star-3" />
        <img src="imgs/star-full.png" class="star-icon" id="star-4" />
        <img src="imgs/star-half.png" class="star-icon" id="star-5" />
      </div>

      <span class="rating-count" id="rating-count">(893)</span>
    </div>

    <div class="product-image-container" id="product-image-container">
      <img src="imgs/cube-3d-icon.png" id="product-image" />
      <div class="loading-product" id="loading-product">
        <video class="loading-video" id="loading-video" src="imgs/loading-spinner.webm" width="8" height="8" loop muted></video>
      </div>

    </div>

    <div class="price-section">
      <span class="price" id="price">$79.99</span>
    </div>

    <div class="dimensions-section">
      <span class="section-title">Product Dimensions</span>
      <span class="dimensions-text" id="dimensions-text">1.5" x 24" x 36"</span>
    </div>
  </div>

  <!-- Bottom Control Panel (visually separate card) -->
  <div class="bottom-control-panel" id="bottom-control-panel">
    <!-- Back Button -->
    <div class="control-button" id="back-button">
      <img src="imgs/exit.png" class="control-icon" id="back-icon" />
    </div>

    <!-- Hint Button -->
    <div class="control-button" id="hint-button">
      <img src="imgs/hint-button.png" class="control-icon" id="hint-icon" />
    </div>

    <div class="control-divider"></div>

    <!-- Adjust Position Button (disabled initially) -->
    <div class="control-button control-button--disabled" id="adjust-position-button">
      <img src="imgs/move-button-disabled.png" class="control-icon" id="adjust-position-icon" />
    </div>

    <!-- Show Dimensions Button (disabled initially) -->
    <div class="control-button control-button--disabled" id="show-dimensions-button">
      <img src="imgs/show-dimensions-button-disabled.png" class="control-icon" id="show-dimensions-icon" />
    </div>

    <!-- Occlusion Button (disabled initially) -->
    <div class="control-button control-button--disabled" id="occlusion-button">
      <img src="imgs/occlusion-button-disabled.png" class="control-icon" id="occlusion-icon" />
    </div>
  </div>

</div>
